---
import '../styles/global.css';
import '../styles/themes.css';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { alternates, pathFor } from '../lib/i18n.mjs';

const {
  lang,
  copy,
  pageKey = 'home',
  title = copy.meta.title,
  description = copy.meta.description,
  bare = false,
  noindex = false,
  ogImage: ogImageProp = '/og.png',
  path: pathProp,
} = Astro.props;

const origin = `https://${site.domain}`;
const pagePath = pathProp ?? pathFor(pageKey, lang);
const canonical = new URL(pagePath, origin).href;
const alts = (pathProp ? [] : alternates(pageKey)).map((alt) => ({
  code: alt.code,
  url: new URL(alt.path, origin).href,
}));
const defaultUrl = new URL(pathFor(pageKey, 'en'), origin).href;

const ogLocales = {
  en: 'en_US',
  es: 'es_AR',
  de: 'de_DE',
  ru: 'ru_RU',
  pt: 'pt_BR',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  alternateName: site.tagline,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Android',
  url: `${origin}/`,
  installUrl: site.storeUrl,
  inLanguage: lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const ogImage = new URL(ogImageProp, origin).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {alts.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.url} />)}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocales[lang] ?? 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FCF5ED" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Evita el flash de tema: aplica el guardado antes de pintar. -->
    <script is:inline>
      (function () {
        try {
          var fromUrl = new URLSearchParams(location.search).get('theme');
          var saved = localStorage.getItem('tb-theme');
          if (fromUrl) {
            document.documentElement.dataset.theme = fromUrl;
            localStorage.setItem('tb-theme', fromUrl);
          } else if (saved) {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">{copy.nav.skip}</a>
    {!bare && <Nav copy={copy} lang={lang} pageKey={pageKey} />}
    <main id="contenido">
      <slot />
    </main>
    {!bare && <Footer copy={copy} lang={lang} />}
  </body>
</html>
