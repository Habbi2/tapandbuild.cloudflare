---
import themesData from '../data/themes.json';
import { buildTokens } from '../lib/tokens.mjs';
import { storeLink } from '../lib/links.mjs';

const { copy, lang, altPath, home = copy.path } = Astro.props;

const base = copy.paths.home;
const pressPath = copy.paths.press;
const altLang = lang === 'es' ? 'en' : 'es';

const chips = themesData.themes.map((theme) => {
  const { tokens } = buildTokens(theme);
  return {
    slug: theme.slug,
    name: theme.name,
    style: `--chip-bg:${tokens.bg};--chip-primary:${tokens.primary};--chip-surface:${tokens.surface}`,
  };
});

const download = storeLink({ lang, medium: 'nav', campaign: 'home' });
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href={base} aria-label={copy.nav.download === 'Descargar' ? 'Tap & Build, inicio' : 'Tap & Build, home'}>
      <span class="brand__mark" aria-hidden="true">TB</span>
      <span>Tap &amp; Build</span>
    </a>

    <nav class="nav__links" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <a href={`${base}#juego`}>{copy.nav.how}</a>
      <a href={`${base}#temas`}>{copy.nav.themes}</a>
      <a href={pressPath}>{copy.nav.press}</a>
    </nav>

    <div class="nav__actions">
      <a class="lang-link" href={altPath} hreflang={altLang} lang={altLang} aria-label={copy.nav.language}>
        <span class="lang-long">{copy.nav.language}</span>
        <span class="lang-short">{altLang.toUpperCase()}</span>
      </a>

      <div class="theme-wrap">
        <button
          class="icon-btn"
          type="button"
          data-theme-toggle
          aria-expanded="false"
          aria-controls="theme-pop"
          aria-label={copy.nav.themeButton}
          title={copy.nav.themeButton}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <circle cx="12" cy="9" r="1.6" fill="currentColor" stroke="none"></circle>
            <circle cx="9" cy="13.5" r="1.6" fill="currentColor" stroke="none"></circle>
            <circle cx="15" cy="13.5" r="1.6" fill="currentColor" stroke="none"></circle>
          </svg>
        </button>

        <div class="theme-pop" id="theme-pop" hidden>
          <p class="theme-pop__title">{copy.nav.themeButton}</p>
          <div class="theme-pop__grid" role="group" aria-label={copy.nav.themeButton}>
            {chips.map((chip) => (
              <button
                class="chip"
                type="button"
                data-theme-set={chip.slug}
                style={chip.style}
                aria-pressed="false"
                aria-label={chip.name}
                title={chip.name}
              ></button>
            ))}
          </div>
          <p class="theme-pop__hint">{copy.themesSection.note}</p>
        </div>
      </div>

      <a class="btn btn--sm" href={download} data-store>{copy.nav.download}</a>
    </div>
  </div>
</header>

<script>
  const KEY = 'tb-theme';

  function applyTheme(slug) {
    document.documentElement.dataset.theme = slug;
    try {
      localStorage.setItem(KEY, slug);
    } catch {
      /* modo privado */
    }
    document.querySelectorAll('[data-theme-set]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeSet === slug));
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
      if (bg) meta.setAttribute('content', bg);
    }
  }

  // Marca el tema activo al cargar (el script del head ya lo aplicó).
  const current = document.documentElement.dataset.theme || 'cream-vanilla';
  document.querySelectorAll('[data-theme-set]').forEach((btn) => {
    btn.setAttribute('aria-pressed', String(btn.dataset.themeSet === current));
  });

  document.addEventListener('click', (event) => {
    const target = event.target;

    const chip = target.closest('[data-theme-set]');
    if (chip) {
      applyTheme(chip.dataset.themeSet);
      const pop = document.getElementById('theme-pop');
      if (pop && !pop.hidden) {
        pop.hidden = true;
        document.querySelector('[data-theme-toggle]')?.setAttribute('aria-expanded', 'false');
      }
      return;
    }

    const toggle = target.closest('[data-theme-toggle]');
    if (toggle) {
      const pop = document.getElementById('theme-pop');
      if (pop) {
        pop.hidden = !pop.hidden;
        toggle.setAttribute('aria-expanded', String(!pop.hidden));
      }
      return;
    }

    const pop = document.getElementById('theme-pop');
    if (pop && !pop.hidden && !target.closest('#theme-pop')) {
      pop.hidden = true;
      document.querySelector('[data-theme-toggle]')?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const pop = document.getElementById('theme-pop');
    if (pop && !pop.hidden) {
      pop.hidden = true;
      document.querySelector('[data-theme-toggle]')?.setAttribute('aria-expanded', 'false');
      document.querySelector('[data-theme-toggle]')?.focus();
    }
  });
</script>
