---
import themesData from '../data/themes.json';
import { buildTokens } from '../lib/tokens.mjs';
import { storeLink } from '../lib/links.mjs';
import { LOCALES, pathFor } from '../lib/i18n.mjs';

const { copy, lang, pageKey = 'home' } = Astro.props;

const home = pathFor('home', lang);
const base = home.endsWith('/') ? home : `${home}/`;
const pressPath = pathFor('press', lang);

const chips = themesData.themes.map((theme) => {
  const { tokens } = buildTokens(theme);
  return {
    slug: theme.slug,
    name: theme.name,
    style: `--chip-bg:${tokens.bg};--chip-primary:${tokens.primary};--chip-surface:${tokens.surface}`,
  };
});

const languages = LOCALES.map((locale) => ({
  ...locale,
  href: pathFor(pageKey, locale.code),
  current: locale.code === lang,
}));

const current = languages.find((item) => item.current) ?? languages[0];
const download = storeLink({ lang, medium: 'nav', campaign: 'home' });
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href={base} aria-label="Tap & Build">
      <span class="brand__mark" aria-hidden="true">TB</span>
      <span>Tap &amp; Build</span>
    </a>

    <nav class="nav__links" aria-label={copy.nav.mainLabel}>
      <a href={`${base}#juego`}>{copy.nav.how}</a>
      <a href={`${base}#temas`}>{copy.nav.themes}</a>
      <a href={pressPath}>{copy.nav.press}</a>
    </nav>

    <div class="nav__actions">
      <div class="theme-wrap">
        <button
          class="icon-btn lang-btn"
          type="button"
          data-lang-toggle
          aria-expanded="false"
          aria-controls="lang-pop"
          aria-label={copy.nav.language}
          title={copy.nav.language}
        >
          {current.short}
        </button>

        <div class="theme-pop lang-pop" id="lang-pop" hidden>
          <p class="theme-pop__title">{copy.nav.language}</p>
          <ul class="lang-list">
            {languages.map((item) => (
              <li>
                <a
                  href={item.href}
                  hreflang={item.code}
                  lang={item.code}
                  class:list={['lang-item', item.current && 'is-current']}
                  aria-current={item.current ? 'true' : undefined}
                >
                  <span>{item.label}</span>
                  <span class="lang-item__code">{item.short}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="theme-wrap">
        <button
          class="icon-btn"
          type="button"
          data-theme-toggle
          aria-expanded="false"
          aria-controls="theme-pop"
          aria-label={copy.nav.themeButton}
          title={copy.nav.themeButton}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <circle cx="12" cy="9" r="1.6" fill="currentColor" stroke="none"></circle>
            <circle cx="9" cy="13.5" r="1.6" fill="currentColor" stroke="none"></circle>
            <circle cx="15" cy="13.5" r="1.6" fill="currentColor" stroke="none"></circle>
          </svg>
        </button>

        <div class="theme-pop" id="theme-pop" hidden>
          <p class="theme-pop__title">{copy.nav.themeButton}</p>
          <div class="theme-pop__grid" role="group" aria-label={copy.nav.themeButton}>
            {chips.map((chip) => (
              <button
                class="chip"
                type="button"
                data-theme-set={chip.slug}
                style={chip.style}
                aria-pressed="false"
                aria-label={chip.name}
                title={chip.name}
              ></button>
            ))}
          </div>
          <p class="theme-pop__hint">{copy.themesSection.note}</p>
        </div>
      </div>

      <a class="btn btn--sm" href={download} data-store>{copy.nav.download}</a>
    </div>
  </div>
</header>

<script>
  const KEY = 'tb-theme';

  function closeAll(except) {
    for (const id of ['theme-pop', 'lang-pop']) {
      if (id === except) continue;
      const el = document.getElementById(id);
      if (el && !el.hidden) {
        el.hidden = true;
        const btn = document.querySelector(`[aria-controls="${id}"]`);
        btn?.setAttribute('aria-expanded', 'false');
      }
    }
  }

  function applyTheme(slug) {
    document.documentElement.dataset.theme = slug;
    try {
      localStorage.setItem(KEY, slug);
    } catch {
      /* modo privado */
    }
    document.querySelectorAll('[data-theme-set]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeSet === slug));
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
      if (bg) meta.setAttribute('content', bg);
    }
  }

  const currentTheme = document.documentElement.dataset.theme || 'cream-vanilla';
  document.querySelectorAll('[data-theme-set]').forEach((btn) => {
    btn.setAttribute('aria-pressed', String(btn.dataset.themeSet === currentTheme));
  });

  document.addEventListener('click', (event) => {
    const target = event.target;

    const chip = target.closest('[data-theme-set]');
    if (chip) {
      applyTheme(chip.dataset.themeSet);
      closeAll();
      return;
    }

    for (const [attr, id] of [
      ['data-theme-toggle', 'theme-pop'],
      ['data-lang-toggle', 'lang-pop'],
    ]) {
      const toggle = target.closest(`[${attr}]`);
      if (!toggle) continue;
      const pop = document.getElementById(id);
      if (!pop) return;
      const willOpen = pop.hidden;
      closeAll(willOpen ? id : undefined);
      pop.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
      return;
    }

    if (!target.closest('.theme-pop')) closeAll();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeAll();
    document.querySelector('[aria-expanded="true"]')?.blur();
  });
</script>
