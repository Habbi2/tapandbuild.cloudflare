---
import { pathFor } from '../lib/i18n.mjs';

const { copy, lang } = Astro.props;
const p = copy.pressPage;
---

<section class="section" style="border-top: none;">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{lang === 'es' ? 'Para medios' : 'For media'}</p>
      <h1 class="section__title">{p.title}</h1>
      <p class="section__lead">{p.lead}</p>
    </header>

    <div class="press-grid">
      <div class="press-card">
        <h2 class="press-card__title">{p.factsTitle}</h2>
        <dl class="facts">
          {p.facts.map((fact) => (
            <div class="facts__row">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="press-card">
        <h2 class="press-card__title">{p.differentTitle}</h2>
        <ul class="press-list">
          {p.different.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="press-card press-card--wide">
      <h2 class="press-card__title">{p.assetsTitle}</h2>
      <p>{p.assetsText}</p>
    </div>

    <div class="press-card press-card--wide">
      <h2 class="press-card__title">{p.contactTitle}</h2>
      <p>{p.contactText}</p>
      <p><a class="press-mail" href="mailto:support@tapandbuild.com">support@tapandbuild.com</a></p>
    </div>

    <p style="margin-top: 32px;">
      <a href={pathFor("home", lang)} class="bio__link" style="color: var(--action);">
        ← {p.backHome}
      </a>
    </p>
  </div>
</section>

<style>
  .press-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .press-card {
    border: 2px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    padding: 28px 26px;
  }

  .press-card--wide {
    margin-top: 20px;
  }

  .press-card__title {
    font-size: 19px;
    margin-bottom: 16px;
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
    font-size: 15px;
  }

  .facts__row:last-child {
    border-bottom: 0;
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }

  .press-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .press-list strong {
    display: block;
    font-size: 15.5px;
  }

  .press-list span {
    color: var(--muted);
    font-size: 14.5px;
  }

  .press-mail {
    font-weight: 800;
    color: var(--action);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .press-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
