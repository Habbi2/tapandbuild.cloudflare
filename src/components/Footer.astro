---
import site from '../data/site.json';
import { pathFor } from '../lib/i18n.mjs';

const { copy, lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__inner">
      <div>
        <a class="brand" href={pathFor('home', lang)}>
          <span class="brand__mark" aria-hidden="true">TB</span>
          <span>Tap &amp; Build</span>
        </a>
        <p style="color: var(--muted); font-size: 14px; margin-top: 10px;">{copy.footer.tagline}</p>
      </div>

      <nav class="footer__links" aria-label="Legal">
        <a href={pathFor('press', lang)}>{copy.footer.links.press}</a>
        <a href={pathFor('privacy', lang)}>{copy.footer.links.privacy}</a>
        <a href={pathFor('terms', lang)}>{copy.footer.links.terms}</a>
        <a href={pathFor('deletion', lang)}>{copy.footer.links.deletion}</a>
      </nav>
    </div>

    <div class="footer__legal">
      <span>© {year} {site.name}. {copy.footer.rights}</span>
      <span>{site.domain}</span>
    </div>
  </div>
</footer>
