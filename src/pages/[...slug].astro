---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import PressBody from '../components/PressBody.astro';
import LegalBody from '../components/LegalBody.astro';
import routes from '../data/routes.json';
import { getCopy, localeMeta } from '../lib/i18n.mjs';

export function getStaticPaths() {
  const paths = [];
  for (const [pageKey, byLocale] of Object.entries(routes)) {
    for (const [lang, path] of Object.entries(byLocale)) {
      const slug = path.replace(/^\/|\/$/g, '');
      paths.push({ params: { slug: slug || undefined }, props: { pageKey, lang } });
    }
  }
  return paths;
}

const { pageKey, lang } = Astro.props;
const copy = getCopy(lang);
const locale = localeMeta(lang);

const legalSlug = { privacy: 'privacy', terms: 'terms', deletion: 'data-deletion' }[pageKey];

const pressTitles = {
  en: 'Press kit — Tap & Build',
  es: 'Prensa — Tap & Build',
  de: 'Presse — Tap & Build',
  ru: 'Пресса — Tap & Build',
  pt: 'Imprensa — Tap & Build',
};

const meta = legalSlug ? copy.legalMeta[pageKey] : null;

// El título depende de la página: sólo prensa usa el suyo.
const title =
  meta?.title ?? (pageKey === 'press' ? pressTitles[lang] : copy.meta.title);
const description =
  meta?.description ?? (pageKey === 'press' ? copy.pressPage.description : copy.meta.description);

// OG por página: home de cada idioma, prensa propia, legales genérica.
const ogImage =
  pageKey === 'home'
    ? `/og/home-${lang}.png`
    : pageKey === 'press'
      ? '/og/press.png'
      : '/og.png';
---

<Base lang={lang} copy={copy} pageKey={pageKey} title={title} description={description} ogImage={ogImage}>
  {pageKey === 'home' && <Home copy={copy} lang={lang} />}
  {pageKey === 'press' && <PressBody copy={copy} lang={lang} />}
  {legalSlug && <LegalBody lang={lang} slug={legalSlug} />}
</Base>
