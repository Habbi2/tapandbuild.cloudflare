---
import Base from '../layouts/Base.astro';
import copy from '../data/copy/en.json';
import { storeLink } from '../lib/links.mjs';

const download = storeLink({ lang: 'en', medium: '404', campaign: 'not-found' });
---

<Base lang="en" copy={copy} pageKey="home" path="/404/" noindex={true} title="Page not found — Tap & Build">
  <section class="section" style="border-top: none;">
    <div class="wrap" style="max-width: 720px;">
      <p class="eyebrow">404</p>
      <h1 class="section__title" style="font-size: clamp(34px, 6vw, 56px);">This page doesn't exist.</h1>
      <p class="section__lead">
        The link is broken or the page moved. The game is still there, though.
      </p>

      <div class="hero__actions">
        <a class="btn" href={download} data-store>Play free</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>
